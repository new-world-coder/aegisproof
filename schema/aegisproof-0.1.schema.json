{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegisproof.dev/schema/aegisproof-0.1.schema.json",
  "title": "AegisProof Evidence Package Manifest",
  "description": "v0.1 local-first evidence package. Integrity only — not a compliance verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specVersion", "system", "producer", "createdAt", "evidence"],
  "properties": {
    "specVersion": {
      "type": "string",
      "const": "0.1"
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "profiles": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    },
    "externalDocuments": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "locator"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["spdx", "cyclonedx", "other"]
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative path from package root; validated by CLI for path escape"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/evidenceItem" }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "locator", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "type": "string",
          "enum": [
            "evaluation",
            "policy",
            "test-result",
            "sbom",
            "sarif",
            "model-card",
            "runtime-receipt",
            "other"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Relative path from package root; no .. or absolute paths"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256
        },
        "producedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
